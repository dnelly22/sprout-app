# PUBLIC build-time config only. Every VITE_* value is inlined into the client
# bundle, so it is NOT secret — never put private keys/tokens here (those belong
# in Vercel env vars and are read only by the /api/* serverless functions).

# RevenueCat public SDK key for the iOS app.
# Currently the RevenueCat *Test Store* key (simulated purchases, for dev).
# Before submitting to the App Store, replace with the App Store "appl_…" key.
VITE_RC_IOS_KEY=test_qXMjPMNSVSHvXQVRrcQVCwzuSSF
